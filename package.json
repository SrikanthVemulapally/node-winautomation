{
  "name": "node-winautomation",
  "version": "1.0.0",
  "description": "Complete Windows automation library with UI Automation and COM support for Office (Excel, Word, PowerPoint, Outlook, Access, OneNote, Visio), SAP GUI, and Acrobat",
  "main": "index.js",
  "scripts": {
    "configure": "node-gyp configure",
    "build": "node-gyp build",
    "clean": "node-gyp clean",
    "rebuild": "node-gyp rebuild",
    "install": "node-gyp rebuild",
    "test": "cd tests && npm test"
  },
  "types": "./index.d.ts",
  "keywords": [
    "windows",
    "automation",
    "ui-automation",
    "desktop",
    "testing",
    "accessibility",
    "excel",
    "word",
    "powerpoint",
    "outlook",
    "com-automation",
    "office-automation",
    "sap-gui"
  ],
  "author": "Srikanth",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SrikanthVemulapally/node-winautomation.git"
  },
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=14.0.0"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "binding.gyp",
    "features/**/*",
    "README.md",
    "LICENSE"
  ],
  "gypfile": true,
  "dependencies": {
    "bindings": "^1.5.0",
    "node-addon-api": "^4.1.0",
    "node-rdpjs": "^0.3.0"
  }
}
